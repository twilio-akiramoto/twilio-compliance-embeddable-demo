# Server Configuration
PORT=3011
NODE_ENV=development

# Twilio Credentials (REQUIRED - Replace with your actual credentials)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Australia Alphanumeric Sender ID Mock Mode (set to 'true' if API not available yet)
AU_ALPHANUMERIC_MOCK_MODE=false

# For Secondary Customer Profiles (OPTIONAL - only if using this product)
PRIMARY_PROFILE_SID=BUxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS Configuration
FRONTEND_URL=http://localhost:3010
CUSTOMER_PORTAL_URL=http://localhost:3020
CSM_DASHBOARD_URL=http://localhost:3030

# Authentication (REQUIRED for customer portal and dashboard)
# Generate a strong random string for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# Email Configuration (REQUIRED for sending invitations)
# Get your SendGrid API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourcompany.com

# Database Configuration
# SQLite (for development/demo)
DATABASE_URL=sqlite:./database.sqlite
# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: Status callback URL (for webhooks)
STATUS_CALLBACK_URL=http://localhost:3011/api/webhooks/compliance-status
